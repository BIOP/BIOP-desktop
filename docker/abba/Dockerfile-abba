ARG BASE_IMAGE=0.3.1
ARG ALIAS=biop/

FROM ${ALIAS}biop-vnc-base:${BASE_IMAGE}

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-tk python3-venv python3-dev xvfb procps \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q https://github.com/BIOP/ijp-imagetoatlas/releases/download/0.25.0/ABBA-0.25.0.zip \
    && unzip -q ABBA-0.25.0.zip -d /opt/ && rm ABBA-0.25.0.zip \
    && chown -R biop:biop /opt/ABBA-0.25.0

# Pin a specific uv version instead of curl|sh
COPY --from=ghcr.io/astral-sh/uv:0.5.5 /uv /uvx /home/biop/.local/bin/

# As the user who runs ABBA: everything goes to biop's home, where ABBA looks for it.
USER biop
ENV HOME=/home/biop
ENV UV_PYTHON_PREFERENCE=only-system
ENV UV_INSTALL_DIR=/home/biop/.local/bin
ENV PATH="/home/biop/.local/bin:${PATH}"

WORKDIR /opt/ABBA-0.25.0
# What "Install everything" does, without the window: Java, ABBA, Fiji, DeepSlice, Elastix, BrainGlobe
RUN uv run --frozen --no-dev abba prepare --all


USER root

# Make icons on desktop
COPY icons/ /opt/icons/
# to start ABBA
RUN mv /opt/icons/desktop-files/specific/abba.desktop /home/biop/Desktop/ \
    && chmod 755 /home/biop/Desktop/abba.desktop \
    && chown biop:biop /home/biop/Desktop/abba.desktop \
    # move scripts to /usr/local/bin/ and make sure they are executable
    && mv /opt/icons/scripts/* /usr/local/bin/ \
    # make sure the scripts are executable and have the correct line endings (remove Windows carriage returns)
    && sed -i 's/\r$//' /usr/local/bin/*.sh \ 
    && chmod 755 /usr/local/bin/*


#################################################################
# Container start
USER biop
WORKDIR /home/biop
ENTRYPOINT ["jupyter"]
CMD ["lab", "--allow-root", "--ip=*", "--port=8888", "--no-browser", "--NotebookApp.token=''", "--NotebookApp.allow_origin='*'", "--notebook-dir=/home/biop/"]